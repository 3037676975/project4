CONFIG_ENCRYPTION_KEY=
PLATFORM_ADMIN_EMAILS=owner@example.com

# Optional commercial gateways. Production billing remains disabled until these are configured.
PAYMENT_MODE=disabled
PAYMENT_PROVIDER=gateway
PAYMENT_CHECKOUT_URL=
PAYMENT_REFUND_URL=
PAYMENT_CALLBACK_SECRET=
PAYMENT_MERCHANT_ID=
OPERATIONS_SWEEP_SECRET=

# Hosted Workers can send directly through SMTP 465/587; an HTTPS/internal relay remains optional for private deployments.
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KnowFlow
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
EMAIL_CODE_EXPIRY_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_LENGTH=6

# Optional external vector database.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowflow_chunks
QDRANT_VECTOR_SIZE=1024
