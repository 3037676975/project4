# scripts/init-private.sh or scripts/init-private.ps1 creates .env.private automatically.
CONFIG_ENCRYPTION_KEY=replace-with-base64-32-byte-key
LOCAL_AUTH_EMAIL=admin@local.test
LOCAL_AUTH_NAME=本地管理员
LOCAL_ADMIN_PASSWORD=replace-with-random-password
LOCAL_AUTH_SESSION_SECRET=replace-with-random-session-secret
PARSER_API_KEY=replace-with-random-token
LOCAL_OCR_MODE=paddleocr
DEEPSEEK_API_KEY=
QDRANT_API_KEY=replace-with-random-token
PAYMENT_CALLBACK_SECRET=replace-with-random-token
OPERATIONS_SWEEP_SECRET=replace-with-random-token
MAIL_RELAY_TOKEN=replace-with-random-token
SMTP_ENABLED=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-qq-number@qq.com
SMTP_PASSWORD=your-qq-smtp-authorization-code
SMTP_FROM_EMAIL=your-qq-number@qq.com
SMTP_FROM_NAME=KnowFlow
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
EMAIL_CODE_EXPIRY_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_LENGTH=6
